<Window x:Class="CodexHp.App.Presentation.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexHp Settings"
        Width="650"
        Height="588"
        MinWidth="480"
        MinHeight="360"
        FontFamily="Segoe UI"
        FontSize="13"
        ThemeMode="System"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsSelectedBrush"
                         Color="{DynamicResource TextFillColorPrimary}"
                         Opacity="0.44" />

        <Style x:Key="NavigationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBackground"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="{DynamicResource SettingsSelectedBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.5,0.5,0.5,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionBodyStyle" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="ToolTip" Value="Choose color" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderThickness" Value="1.5" />
                                <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CompactCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ColorLabelStyle" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,10,6" />
        </Style>
        <Style x:Key="ColorTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ColorDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid x:Name="SettingsRoot" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="NavigationPanel" Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0.5">
        <StackPanel>
        <ListBox x:Name="GroupList"
                 Grid.Row="0"
                 Grid.Column="0"
                 Width="130"
                 ItemsSource="{Binding Groups}"
                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                 DisplayMemberPath="Title"
                 FontSize="13"
                 Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                 BorderThickness="0.5"
                 ItemContainerStyle="{StaticResource NavigationItemStyle}"
                 SelectionChanged="OnGroupSelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

        <Border Margin="8,8,8,0" Padding="0,8,0,0" BorderThickness="0,0.5,0,0"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAvailableUpdate}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Button x:Name="UpdateLinkButton" Click="OnUpdateLinkClick" Padding="4,6"
                    HorizontalContentAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    ToolTip="{Binding UpdateLinkDescription}"
                    AutomationProperties.Name="{Binding UpdateLinkDescription}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#3A8EFF" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="Update ↗" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Border>
        </StackPanel>
        </Border>

        <ScrollViewer x:Name="SettingsContentScroller"
                      Grid.Row="0"
                      Grid.Column="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid x:Name="GeneralPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="GeneralHeader" Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock x:Name="GeneralSectionTitle"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="General" />
                </Border>
                <Border x:Name="GeneralBody"
                        Grid.Row="1"
                        Style="{StaticResource SectionBodyStyle}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource CompactCheckBoxStyle}"
                                  Content="Run CodexHp when Windows starts"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  IsEnabled="{Binding CanStartWithWindows}"
                                  Margin="0,0,0,4" />
                        <CheckBox Style="{StaticResource CompactCheckBoxStyle}"
                                  Content="Show the usage overlay only while the ChatGPT desktop app is running"
                                  IsEnabled="{Binding CanChooseProcessVisibility}"
                                  IsChecked="{Binding ShowOnlyWhenChatGptRunning, Mode=TwoWay}" />
                        <TextBlock Text="Upper bar" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <ComboBox x:Name="UpperBarModeComboBox" Width="180" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Upper bar display mode"
                                  ItemsSource="{Binding UpperBarModes}"
                                  SelectedIndex="{Binding UpperBarModeIndex, Mode=TwoWay}" />
                        <TextBlock Text="Show the 5-hour limit or banked resets and their next expiry."
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ColorPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Colors" />
                </Border>
                <Border Grid.Row="1" Style="{StaticResource SectionBodyStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="Mode" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox x:Name="ColorModeComboBox" Width="140" HorizontalAlignment="Right"
                                          AutomationProperties.Name="Overlay color mode"
                                          ItemsSource="{Binding ColorModes}"
                                          SelectedItem="{Binding ColorMode, Mode=TwoWay}" />
                            </DockPanel>
                        </StackPanel>
                        <Grid Grid.Row="1" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="48" />
                                <RowDefinition Height="Auto" MinHeight="48" />
                                <RowDefinition Height="Auto" MinHeight="48" />
                                <RowDefinition Height="Auto" MinHeight="48" />
                                <RowDefinition Height="Auto" MinHeight="48" />
                                <RowDefinition Height="Auto" MinHeight="48" />
                                <RowDefinition Height="Auto" MinHeight="48" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource ColorLabelStyle}">
                                <TextBlock Style="{StaticResource ColorTitleStyle}" Text="ManaBar" />
                                <TextBlock Style="{StaticResource ColorDescriptionStyle}" Text="5-hour usage or banked resets" />
                            </StackPanel>
                            <Button x:Name="ManaColorSwatch" Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource ColorSwatchButtonStyle}" Click="OnPickManaColor"
                                    AutomationProperties.Name="Upper bar color" />
                            <StackPanel Grid.Row="1" Style="{StaticResource ColorLabelStyle}">
                                <TextBlock Style="{StaticResource ColorTitleStyle}" Text="HpBar" />
                                <TextBlock Style="{StaticResource ColorDescriptionStyle}" Text="Token limit gauge for one week" />
                            </StackPanel>
                            <Button x:Name="HpColorSwatch" Grid.Row="1" Grid.Column="1"
                                    Style="{StaticResource ColorSwatchButtonStyle}" Click="OnPickHpColor"
                                    AutomationProperties.Name="Weekly gauge color" />
                            <StackPanel Grid.Row="2" Style="{StaticResource ColorLabelStyle}">
                                <TextBlock Style="{StaticResource ColorTitleStyle}" Text="Refresh Gauge" />
                                <TextBlock Style="{StaticResource ColorDescriptionStyle}" Text="Time remaining until token limit reset" />
                            </StackPanel>
                            <Button x:Name="RefreshColorSwatch" Grid.Row="2" Grid.Column="1"
                                    Style="{StaticResource ColorSwatchButtonStyle}" Click="OnPickRefreshColor"
                                    AutomationProperties.Name="Refresh gauge color" />
                            <StackPanel Grid.Row="3" Style="{StaticResource ColorLabelStyle}">
                                <TextBlock Style="{StaticResource ColorTitleStyle}" Text="Issue Stripe" />
                                <TextBlock Style="{StaticResource ColorDescriptionStyle}" Text="OpenAI service issue detected" />
                            </StackPanel>
                            <Button x:Name="IssueColorSwatch" Grid.Row="3" Grid.Column="1"
                                    Style="{StaticResource ColorSwatchButtonStyle}" Click="OnPickIssueColor"
                                    AutomationProperties.Name="Service issue stripe color" />
                            <StackPanel Grid.Row="4" Style="{StaticResource ColorLabelStyle}">
                                <TextBlock Style="{StaticResource ColorTitleStyle}" Text="Unknown Stripe" />
                                <TextBlock Style="{StaticResource ColorDescriptionStyle}" Text="Unable to check OpenAI service status" />
                            </StackPanel>
                            <Button x:Name="UnknownColorSwatch" Grid.Row="4" Grid.Column="1"
                                    Style="{StaticResource ColorSwatchButtonStyle}" Click="OnPickUnknownColor"
                                    AutomationProperties.Name="Unknown status stripe color" />
                            <StackPanel Grid.Row="5" Style="{StaticResource ColorLabelStyle}">
                                <TextBlock Style="{StaticResource ColorTitleStyle}" Text="Token Graph Low" />
                                <TextBlock Style="{StaticResource ColorDescriptionStyle}" Text="≤10K tokens per 15s" />
                            </StackPanel>
                            <Button x:Name="TokenLowColorSwatch" Grid.Row="5" Grid.Column="1"
                                    Style="{StaticResource ColorSwatchButtonStyle}" Click="OnPickTokenLowColor"
                                    AutomationProperties.Name="Token graph low color" />
                            <StackPanel Grid.Row="6" Style="{StaticResource ColorLabelStyle}">
                                <TextBlock Style="{StaticResource ColorTitleStyle}" Text="Token Graph High" />
                                <TextBlock Style="{StaticResource ColorDescriptionStyle}" Text="≥100K tokens per 15s" />
                            </StackPanel>
                            <Button x:Name="TokenHighColorSwatch" Grid.Row="6" Grid.Column="1"
                                    Style="{StaticResource ColorSwatchButtonStyle}" Click="OnPickTokenHighColor"
                                    AutomationProperties.Name="Token graph high color" />
                        </Grid>
                        <Button x:Name="ResetColorsButton"
                                Grid.Row="2"
                                Width="120"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource CompactButtonStyle}"
                                Content="Reset to Defaults"
                                Click="OnResetColors" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="AppearancePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Appearance" />
                </Border>
                <Border Grid.Row="1" Style="{StaticResource SectionBodyStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="AppearanceValuesGrid" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Usage Overlay Width" />
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding OverlayWidth, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="DIP" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Usage Overlay Height" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding OverlayHeight, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="DIP" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Gauge Area Width" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding GaugePaneWidth, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="DIP" />
                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Graph Bar Width" />
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding GraphBarWidth, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="DIP" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Graph Bar Gap" />
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding GraphBarGap, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="DIP" />
                        <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Service Status Stripe Width" />
                        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding StatusStripeWidth, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="DIP" />
                        <TextBlock x:Name="VisibleTokenHistoryText"
                                   Grid.Row="6"
                                   Grid.ColumnSpan="3"
                                   Margin="0,6,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding VisibleTokenHistoryText}" />
                        </Grid>
                        <Button x:Name="ResetAppearanceButton"
                                Grid.Row="1"
                                Width="120"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource CompactButtonStyle}"
                                Content="Reset to Defaults"
                                Click="OnResetAppearance" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="OverlayPositionPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Overlay Position" />
                </Border>
                <Border Grid.Row="1" Style="{StaticResource SectionBodyStyle}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Drag the usage overlay to the desired location." />
                </Border>
            </Grid>

            <Grid x:Name="AboutPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="About" />
                </Border>
                <Border Grid.Row="1" Style="{StaticResource SectionBodyStyle}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextBlock.TextAlignment="Center">
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="{Binding ApplicationTitleText}" />
                        <TextBlock x:Name="AboutVersionText"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ApplicationVersionText}" />
                        <TextBlock x:Name="AboutCommitText"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ApplicationCommitText}" />
                        <TextBlock x:Name="AboutDeveloperEmailText"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Developer: netics01@gmail.com" />
                        <StackPanel Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Repository: " />
                            <TextBlock>
                                <Hyperlink x:Name="AboutRepositoryLink"
                                           NavigateUri="https://github.com/netics01/codexhp"
                                           RequestNavigate="OnRepositoryRequestNavigate">https://github.com/netics01/codexhp</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>

        <StackPanel x:Name="ActionButtons"
                    Grid.Row="1"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="OkButton"
                    Width="92"
                    Height="26"
                    Margin="0,0,10,0"
                    Style="{StaticResource CompactButtonStyle}"
                    Content="OK"
                    IsDefault="True"
                    Click="OnConfirm" />
            <Button x:Name="CancelButton"
                    Width="92"
                    Height="26"
                    Style="{StaticResource CompactButtonStyle}"
                    Content="Cancel"
                    IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
